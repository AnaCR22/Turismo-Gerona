                    <longitud>2.82388</longitud>
                    <latitud>41.98457</latitud>
                    <altitud>68</altitud>
                </coordenadas>
                <distancia unidad="m">0</distancia>
                <fotos>
                    <foto url="./multimedia/ruta1/PontEiffel.jpg" descripcion="Vista general del puente rojo sobre el río Onyar"/>
                </fotos>
            </hito>
            
