            <referencia fuente="Wikipedia" url="https://es.wikipedia.org/wiki/Gerona">Gerona: artículo general sobre la ciudad y su patrimonio</referencia>
            <referencia fuente="Catalunya Turisme" url="https://catalunyaturisme.cat/es/girona/">Qué hacer y qué ver en Girona</referencia>
        </referencias>

        <recomendacion>10</recomendacion>

