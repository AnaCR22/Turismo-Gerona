<?xml version='1.0' encoding='utf-8'?>
<kml xmlns="http://www.opengis.net/kml/2.2">
  <Document>
    <Placemark>
      <name>Ruta Monumental del Casco Histórico de Girona - Inicio</name>
      <description>Punto de inicio de la ruta</description>
      <Point>
        <coordinates>2.823893,41.984575,72</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Pont de les Peixateries Velles (Pont Eiffel)</name>
      <description>Puente metálico rojo construido en 1876. Conecta el Mercadal con la Rambla de la Lliberta.</description>
      <Point>
        <coordinates>2.823893,41.984575,72</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>El Call Jueu (Barrio Judío)</name>
      <description>El barrio judío de Gerona fue el centro de una de las comunidades judías más activas de España, y hoy es uno de los barrios judíos mejor conservados de la península ibérica.</description>
      <Point>
        <coordinates>2.825210,41.986797,85</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Catedral de Santa Maria de Girona</name>
      <description>Templo construido entre los siglos XI y XVIII con elementos románicos, góticos y barrocos.</description>
      <Point>
        <coordinates>2.825771,41.987338,92</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Banys Àrabs (Baños Árabes)</name>
      <description>Fueron construidos en 1194 con una estructura que imitaba la de los baños musulmanes. 
                    Los baños están divididos en cinco recintos: los vestuarios, la sala fría, la sala tibia, la sala caliente y la sala del horno y la caldera.
                </description>
      <Point>
        <coordinates>2.825873,41.988122,84</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Basílica de Sant Feliu</name>
      <description>Iglesia levantada entre los siglos XII y XVII sobre una necrópolis romana.</description>
      <Point>
        <coordinates>2.824736,41.988261,76</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <name>Ruta Monumental del Casco Histórico de Girona</name>
