  <Document>
    <Placemark>
      <name>Ruta Monumental del Casco Histórico de Girona - Inicio</name>
      <description>Punto de inicio de la ruta</description>
      <Point>
        <coordinates>2.82388,41.98457,68</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Pont de les Peixateries Velles (Pont Eiffel)</name>
      <description>Puente metálico rojo construido en 1876. Conecta el Mercadal con la Rambla de la Lliberta.</description>
      <Point>
        <coordinates>2.82388,41.98457,68</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>El Call Jueu (Barrio Judío)</name>
      <description>Una de las juderías medievales mejor conservadas de Europa.</description>
      <Point>
        <coordinates>2.82520,41.98600,78</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Catedral de Santa Maria de Girona</name>
      <description>Templo construido entre los siglos XI y XVIII con elementos románicos, góticos y barrocos.</description>
      <Point>
        <coordinates>2.82631,41.98743,93</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Banys Àrabs (Baños Árabes)</name>
      <description>Edificio románico de 1194. Es el conjunto de baños románicos mejor conservado de Cataluña.</description>
      <Point>
        <coordinates>2.82750,41.98830,86</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
    <Placemark>
      <name>Basílica de Sant Feliu</name>
      <description>Iglesia levantada entre los siglos XII y XVII sobre una necrópolis romana.</description>
      <Point>
        <coordinates>2.82480,41.98640,74</coordinates>
        <altitudeMode>relativeToGround</altitudeMode>
      </Point>
    </Placemark>
